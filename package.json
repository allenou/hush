{
  "name": "hush-search",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt --browser edge",
    "dev:firefox": "wxt --browser firefox",
    "web": "npm --prefix web run dev",
    "build": "wxt build",
    "build:edge": "wxt build --browser edge",
    "build:firefox": "wxt build --browser firefox",
    "zip": "wxt zip",
    "zip:edge": "wxt zip --browser edge",
    "zip:firefox": "wxt zip --browser firefox",
    "wxt-prepare": "wxt prepare",
    "test": "vitest run",
    "test:release": "npm run zip && node tests/release-artifacts.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/chrome": "^0.2.2",
    "@wxt-dev/module-svelte": "^2.0.0",
    "jsdom": "^29.1.1",
    "svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@sentry/browser": "^10.69.0",
    "chart.js": "^4.5.1"
  }
}
