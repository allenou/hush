---
import { getTranslations, type Locale } from '../utils/i18n';
import { sitePath } from '../utils/paths';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isZh = lang === 'zh-CN';
const messages = getTranslations(lang).footer;
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div>
      <a class="brand footer-brand" href={isZh ? sitePath('zh/') : sitePath()}>
        <span class="brand-mark"><img src={sitePath('icon.svg')} alt="" /></span>
        <span>Hush</span>
      </a>
      <p>{messages.tagline}</p>
    </div>
    <div class="footer-links">
      <a href={isZh ? sitePath('zh/privacy/') : sitePath('privacy/')}>{messages.privacy}</a>
      <a href={isZh ? sitePath('zh/changelog/') : sitePath('changelog/')}>{messages.changelog}</a>
      <a href="https://github.com/allenou/hush">GitHub</a>
    </div>
  </div>
  <div class="shell footer-bottom">
    <span>© {new Date().getFullYear()} Hush</span>
    <span>{messages.localData}</span>
  </div>
</footer>
