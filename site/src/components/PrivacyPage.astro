---
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { getTranslations, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const messages = getTranslations(lang).privacy;
---

<SiteHeader lang={lang} page="privacy" />

<main class="policy-main">
  <div class="shell policy-intro">
    <div class="policy-heading">
      <h1>{messages.title}</h1>
      <p class="policy-date">{messages.updated}</p>
    </div>
  </div>

  <div class="shell policy-layout">
    <article class="policy-article">
      <div class="local-first">
        <span class="shield-small" aria-hidden="true">✓</span>
        <p>{messages.summary}</p>
      </div>

      <section id="data">
        <h2>{messages.data.title}</h2>
        <p>{messages.data.intro}</p>
        <ul>
          {messages.data.items.map((item) => <li>{item}</li>)}
        </ul>
        <p>{messages.data.outro}</p>
      </section>

      <section id="processing">
        <h2>{messages.processing.title}</h2>
        <p>{messages.processing.description}</p>
        <p>{messages.processing.scope}</p>
      </section>

      <section id="permissions">
        <h2>{messages.permissions.title}</h2>
        <dl class="permission-list">
          <div><dt>storage</dt><dd>{messages.permissions.storage}</dd></div>
          <div><dt>{messages.permissions.hostTitle}</dt><dd>{messages.permissions.hostDescription}</dd></div>
        </dl>
      </section>

      <section id="changes">
        <h2>{messages.changes.title}</h2>
        <p>{messages.changes.description}</p>
      </section>

    </article>
  </div>
</main>

<SiteFooter lang={lang} />
