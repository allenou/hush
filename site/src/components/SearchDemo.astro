---
import { getTranslations, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const messages = getTranslations(lang).searchDemo;
---

<div class="search-demo" aria-label={messages.ariaLabel}>
  <div class="browser-bar">
    <span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <div class="address-bar">search.example.com/results?q=quiet+search</div>
  </div>
  <div class="search-page">
    <div class="demo-search"><span aria-hidden="true">⌕</span>{messages.query}</div>
    <article class="demo-result">
      <span class="result-source">helpful.example</span>
      <h3>{messages.primaryTitle}</h3>
      <p>{messages.primaryDescription}</p>
      <button class="mark-control" type="button" aria-label={messages.markAriaLabel}>＋</button>
    </article>
    <article class="demo-result covered">
      <div class="cover-content">
        <span class="shield-small" aria-hidden="true">✓</span>
        <div>
          <strong>{messages.marked}</strong>
          <span>{messages.rule}</span>
        </div>
        <button type="button">{messages.show}</button>
      </div>
    </article>
    <article class="demo-result compact">
      <span class="result-source">reference.example</span>
      <h3>{messages.secondaryTitle}</h3>
    </article>
  </div>
</div>
