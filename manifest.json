{
  "name": "DP BOT",
  "description": "Biu biu biu",
  "version": "0.1.1",
  "manifest_version": 3,
  "icons": { 
    "16": "./assets/icon-16.png",
    "48": "./assets/icon-32.png",
   "128": "./assets/icon-180.png" },
  "background": {
    "service_worker": "./js/background.js"
  },
  "host_permissions": ["http://*/*", "https://*/*"],
  "permissions": ["contextMenus", "storage", "scripting", "tabs", "activeTab"],

  "action": {
    "default_popup": "./views/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.dianping.com/*", "http://*.dianping.com/*"],
      "js": ["./js/content.js"]
    }
  ]
}
