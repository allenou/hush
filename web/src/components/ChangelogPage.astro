---
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { getChangelog } from '../utils/changelog';
import { getTranslations, type Locale } from '../utils/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const messages = getTranslations(lang).changelog;
const entries = getChangelog(lang);
---

<SiteHeader lang={lang} page="changelog" />

<main class="changelog-main">
  <div class="shell changelog-heading">
    <h1>{messages.title}</h1>
    <p>{messages.description}</p>
  </div>

  <div class="shell changelog-list">
    {entries.map((entry) => (
      <article class="changelog-entry">
        <div class="changelog-meta">
          <span>{entry.version}</span>
          <span>{entry.date}</span>
        </div>
        <div class="changelog-content">
          {entry.sections.map((section) => (
            <>
              <h2>{section.title}</h2>
              <ul>
                {section.items.map((item) => <li>{item}</li>)}
              </ul>
            </>
          ))}
        </div>
      </article>
    ))}
  </div>
</main>

<SiteFooter lang={lang} />
