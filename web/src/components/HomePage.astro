---
import SearchDemo from './SearchDemo.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';
import { getTranslations, type Locale } from '../utils/i18n';
import { sitePath } from '../utils/paths';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const isZh = lang === 'zh-CN';
const messages = getTranslations(lang).home;
const demoCopy = isZh
  ? {
      query: '如何整理搜索结果',
      source: 'reference.example',
      title: '一份清晰、可靠的搜索结果',
      description: '保留真正有用的信息，其余内容由你决定如何处理。',
      ad: '广告',
      history: '可选的本地搜索记录',
      domain: '域名',
      url: 'URL',
      element: '页面元素',
      show: '显示',
      marked: '已由 Hush 标记',
      contextAction: '右键',
      menuTitle: 'Hush - 屏蔽不想看的网页',
    }
  : {
      query: 'how to organize search results',
      source: 'reference.example',
      title: 'A clear and reliable search result',
      description: 'Keep the useful information and decide what happens to the rest.',
      ad: 'Ad',
      history: 'Optional local search history',
      domain: 'Domain',
      url: 'URL',
      element: 'Page element',
      show: 'Show',
      marked: 'Marked by Hush',
      contextAction: 'Right-click',
      menuTitle: 'Hush - Block unwanted pages',
    };
---

<SiteHeader lang={lang} page="home" />

<main>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <h1>{messages.hero.title}</h1>
        <p>{messages.hero.description}</p>
        <div class="hero-actions">
          <a
            class="button primary icon-button edge-button"
            href="https://microsoftedge.microsoft.com/addons/detail/hchngjlgnmfncglllbjpdgnhaglajemn"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M21.72 15.43c-.37.2-.75.38-1.15.53a8.84 8.84 0 0 1-3.14.57c-3.3 0-6.17-1.78-6.17-4.08 0-1.84 1.87-3.42 4.47-3.92-.52-.21-1.16-.34-1.96-.34-2.88 0-5.22 2.12-5.22 4.73 0 3.09 2.85 5.59 6.37 5.59 2.8 0 5.18-1.58 6.8-3.08Z" />
              <path fill="currentColor" opacity=".72" d="M22 12.16C22 6.54 17.52 2 12 2 6.92 2 2.73 5.84 2.09 10.8c1.45-2.4 4.36-4.08 7.76-4.08 2.56 0 4.85.95 6.38 2.45-4.34-.68-7.93 1.36-7.93 4.58 0 3.54 3.28 6.25 7.3 6.25 1.3 0 2.53-.29 3.6-.79A9.92 9.92 0 0 0 22 12.16Z" />
              <path fill="currentColor" opacity=".42" d="M2.09 10.8A10.2 10.2 0 0 0 2 12.16C2 17.6 6.32 22 11.65 22c3.12 0 5.9-1.51 7.55-3.79-1.07.5-2.3.79-3.6.79-4.02 0-7.3-2.71-7.3-6.25 0-2.1 1.53-3.74 3.82-4.4a9.56 9.56 0 0 0-2.27-.27c-3.4 0-6.31 1.69-7.76 4.08v-1.36Z" />
            </svg>
            {messages.hero.getHush}
          </a>
          <a class="button secondary icon-button" href="https://github.com/allenou/hush">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path fill="currentColor" d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.14.68-3.8-1.33-3.8-1.33-.51-1.31-1.25-1.66-1.25-1.66-1.03-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1.01 1.73 2.65 1.23 3.3.94.1-.73.4-1.23.72-1.51-2.51-.29-5.15-1.26-5.15-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15A10.8 10.8 0 0 1 12 6.1c.96 0 1.91.13 2.8.38 2.15-1.46 3.1-1.15 3.1-1.15.62 1.55.23 2.7.12 2.98.72.79 1.15 1.79 1.15 3.02 0 4.31-2.65 5.27-5.17 5.55.4.35.77 1.04.77 2.1v3.12c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" />
            </svg>
            {messages.hero.viewSource}
          </a>
        </div>
        <p class="hero-note">{messages.hero.note}</p>
      </div>
      <SearchDemo lang={lang} />
    </div>
  </section>

  <section class="feature-section" id="features">
    <div class="shell">
      <div class="section-heading">
        <h2>{messages.features.title}</h2>
        <p>{messages.features.description}</p>
      </div>
      <div class="feature-stage">
        <div class="feature-index">
          {messages.features.items.map(({ title, description }, index) => (
            <article class:list={["feature-item", { active: index === 0 }]}>
              <span class="feature-number">0{index + 1}</span>
              <div><h3>{title}</h3><p>{description}</p></div>
            </article>
          ))}
        </div>
        <div class="feature-browser" aria-hidden="true">
          <div class="browser-bar">
            <span class="browser-dots"><i></i><i></i><i></i></span>
            <div class="address-bar">search.example.com</div>
          </div>
          <div class="feature-browser-body">
            <div class="feature-search"><span>⌕</span>{demoCopy.query}</div>
            <div class="feature-result primary-result">
              <span>{demoCopy.source}</span>
              <strong>{demoCopy.title}</strong>
              <p>{demoCopy.description}</p>
              <span class="feature-context-control">{demoCopy.contextAction}</span>
              <div class="rule-popover">
                <strong>{demoCopy.menuTitle}</strong>
                <b>{demoCopy.domain}</b><span>{demoCopy.url}</span><span>{demoCopy.element}</span>
              </div>
            </div>
            <div class="feature-result ad-result">
              <span class="ad-label">{demoCopy.ad}</span>
              <i></i><i></i>
            </div>
            <div class="local-history"><span>✓</span>{demoCopy.history}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="workflow-section">
    <div class="shell">
      <div class="workflow-heading">
        <h2>{messages.workflow.title}</h2>
        <p>{messages.workflow.description}</p>
      </div>
      <ol class="journey">
        <li class="journey-step choose-step">
          <div class="step-copy"><span>01</span><h3>{messages.workflow.steps[0]!.title}</h3><p>{messages.workflow.steps[0]!.description}</p></div>
          <div class="journey-result" aria-hidden="true"><small>{demoCopy.source}</small><strong>{demoCopy.title}</strong><span class="journey-context-control">{demoCopy.contextAction}</span></div>
        </li>
        <li class="journey-step rule-step">
          <div class="step-copy"><span>02</span><h3>{messages.workflow.steps[1]!.title}</h3><p>{messages.workflow.steps[1]!.description}</p></div>
          <div class="journey-menu" aria-hidden="true">
            <strong>{demoCopy.menuTitle}</strong>
            <span class="selected"><i></i>{demoCopy.domain}<b>✓</b></span>
            <span><i></i>{demoCopy.url}</span>
            <span><i></i>{demoCopy.element}</span>
          </div>
        </li>
        <li class="journey-step recover-step">
          <div class="step-copy"><span>03</span><h3>{messages.workflow.steps[2]!.title}</h3><p>{messages.workflow.steps[2]!.description}</p></div>
          <div class="journey-covered" aria-hidden="true"><span class="shield-small">✓</span><strong>{demoCopy.marked}</strong><span class="journey-show-control">{demoCopy.show}</span></div>
        </li>
      </ol>
    </div>
  </section>

  <section class="privacy-band">
    <div class="shell privacy-grid">
      <div class="privacy-symbol" aria-hidden="true">
        <span class="shield-outline">✓</span>
        <span class="local-orbit"></span>
      </div>
      <div>
        <h2>{messages.privacy.title}</h2>
        <p>{messages.privacy.description}</p>
        <a class="text-link" href={isZh ? sitePath('zh/privacy/') : sitePath('privacy/')}>{messages.privacy.link} <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</main>

<SiteFooter lang={lang} />
