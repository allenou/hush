---
import { getTranslations, type Locale } from '../utils/i18n';
import { sitePath } from '../utils/paths';

interface Props {
  lang: Locale;
  page: 'home' | 'privacy';
}

const { lang, page } = Astro.props;
const isZh = lang === 'zh-CN';
const messages = getTranslations(lang).header;
const homeHref = isZh ? sitePath('zh/') : sitePath();
const privacyHref = isZh ? sitePath('zh/privacy/') : sitePath('privacy/');
const pagePaths = {
  home: ['', 'zh/'],
  privacy: ['privacy/', 'zh/privacy/'],
} as const;
const switchHref = sitePath(pagePaths[page][isZh ? 0 : 1]);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={homeHref} aria-label={messages.homeAriaLabel}>
      <span class="brand-mark"><img src={sitePath('icon.png')} alt="" /></span>
      <span>Hush</span>
    </a>
    <nav aria-label={messages.navigationAriaLabel}>
      <a class:list={{ active: page === 'home' }} href={homeHref}>{messages.home}</a>
      <a class:list={{ active: page === 'privacy' }} href={privacyHref}>{messages.privacy}</a>
      <a
        class="language-link"
        href={switchHref}
        hreflang={isZh ? 'en' : 'zh-CN'}
        lang={isZh ? 'en' : 'zh-CN'}
        aria-label={messages.switchLanguageAriaLabel}
      >
        <span>{messages.switchLanguage}</span>
      </a>
    </nav>
  </div>
</header>
